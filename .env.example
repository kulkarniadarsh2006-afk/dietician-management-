# ==============================================================================
# DIETITIAN MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit sensitive credentials or real API keys to version control.
# - Keep .env, .env.local, and .env.production gitignored at all times.
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the client browser.
# - Variables WITHOUT NEXT_PUBLIC_ are SERVER-ONLY and must never reach the browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# [PUBLIC] The fully-qualified base URL of the deployed application or localhost
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [SERVER-ONLY] Runtime environment (development | test | production)
NODE_ENV="development"

# [SERVER-ONLY] Port for the local Next.js server (optional, defaults to 3000)
PORT="3000"


# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Authentication & Private Storage)
# ------------------------------------------------------------------------------
# [PUBLIC] Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# [PUBLIC] Supabase Anon / Public Key (safe for browser with Row Level Security enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# [SERVER-ONLY - CRITICAL SECRET] Supabase Service Role Key.
# Bypasses Row Level Security (RLS). NEVER expose to client-side code or public variables.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"


# ------------------------------------------------------------------------------
# 3. GOOGLE APIS (Google Forms & Google Sheets via Service Account)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] Google Cloud Service Account Email with domain delegation or shared sheet access
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-gcp-project.iam.gserviceaccount.com"

# [SERVER-ONLY] Google Cloud Service Account Private Key (format: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n)
# Note: Escape newlines as \n when placing in single-line env strings
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-escaped-private-key\n-----END PRIVATE KEY-----\n"

# [SERVER-ONLY] Optional: Google Drive folder ID where intake forms are managed
GOOGLE_FORMS_FOLDER_ID="your-google-drive-folder-id-placeholder"

# [SERVER-ONLY] Optional: Default Google Sheets spreadsheet ID for patient intake sync
GOOGLE_SHEETS_SPREADSHEET_ID="your-google-sheets-spreadsheet-id-placeholder"


# ------------------------------------------------------------------------------
# 4. META WHATSAPP BUSINESS PLATFORM (Official Cloud API)
# ------------------------------------------------------------------------------
# [SERVER-ONLY] WhatsApp Cloud API Phone Number ID (from Meta Developer App Dashboard -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id-placeholder"

# [SERVER-ONLY] WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID="your-whatsapp-business-account-id-placeholder"

# [SERVER-ONLY - CRITICAL SECRET] Permanent System User Access Token from Meta Business Manager
WHATSAPP_ACCESS_TOKEN="your-system-user-access-token-placeholder"

# [SERVER-ONLY] Webhook Verification Token (custom secret string you choose for the GET challenge)
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-chosen-random-webhook-verification-token"

# [SERVER-ONLY - CRITICAL SECRET] Meta App Secret used to compute & verify HMAC-SHA256 signatures on incoming webhooks
WHATSAPP_APP_SECRET="your-meta-app-secret-placeholder"
